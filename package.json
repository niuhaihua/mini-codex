{
  "name": "mini-codex",
  "version": "1.0.0",
  "description": "A minimal Codex-style AI coding agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "pnpm clean && pnpm build"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "codex"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}